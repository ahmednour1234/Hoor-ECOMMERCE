/node_modules
# The compiled assets ARE committed, so a fresh clone serves the site without
# needing a Node toolchain. They are regenerated by `npm run build`, so a
# stale bundle here is a nuisance rather than a fault.
#
# /public/hot is a dev-server marker and /public/storage is a symlink created
# by `php artisan storage:link` — both are per-machine and stay out.
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# The local SQLite database.
#
# Excluded because it holds real order records — customer names, addresses and
# phone numbers — which must not enter a public history that cannot be erased.
# Run `php artisan migrate --seed` to build a working catalog instead.
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal
