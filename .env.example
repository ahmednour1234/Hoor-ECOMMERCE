APP_NAME=HOOR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Development uses SQLite: zero setup, and the whole database is one file.
# DB_DATABASE is intentionally unset so Laravel defaults to
# database/database.sqlite. Do NOT set it to a database *name* here - on the
# sqlite driver this value is a file path.
DB_CONNECTION=sqlite

# Production (MySQL) - uncomment this block and comment out the line above.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=hoor_db
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- HOOR ---------------------------------------------------------------
# Initial back-office account created by AdminUserSeeder.
HOOR_ADMIN_NAME="HOOR Admin"
HOOR_ADMIN_EMAIL=admin@hoor.eg
HOOR_ADMIN_PASSWORD=ChangeMe!2026

# Brand contact details surfaced in the storefront footer.
HOOR_NAME_EN=HOOR
HOOR_NAME_AR=حور
HOOR_EMAIL=info@hoor.eg
HOOR_PHONE="+20 100 000 0000"
HOOR_WHATSAPP="+20 100 000 0000"
HOOR_INSTAGRAM=https://instagram.com/hoor
HOOR_FACEBOOK=https://facebook.com/hoor
HOOR_TIKTOK=https://tiktok.com/@hoor

# Media storage
HOOR_MEDIA_DISK=public
HOOR_MAX_UPLOAD_KB=4096

# Google sign-in.
# Create at console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID (Web application), then add the redirect URI below to that
# client's authorised redirect URIs. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/en/auth/google/callback"
